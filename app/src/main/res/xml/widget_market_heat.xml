<?xml version="1.0" encoding="utf-8"?>
<!-- 行情热力图小部件的 AppWidget 配置：默认 4x4 格（按 Android 的格子换算 70*N-30），
     拉伸后热力图会按新尺寸重画（onAppWidgetOptionsChanged）。
     另两个行情部件是 widget_market_list.xml / widget_market_chart.xml。
     注意：这里是 res/xml，与同名的布局 res/layout/widget_market_heat.xml 是两种资源类型。
     整屏只有一个榜单可看，没有配置页，所以不写 android:configure。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/market_heat_widget_desc"
    android:initialLayout="@layout/widget_market_heat"
    android:maxResizeHeight="420dp"
    android:maxResizeWidth="420dp"
    android:minHeight="250dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_market_heat"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
