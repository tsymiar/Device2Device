<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 顶部：服务选择 + API Key 展开按钮。
         这个按钮放在底部输入卡片里会紧贴消息输入框上方 —— 手往输入框去的时候
         易发生误触，一旦触及即弹出 Key 输入框。故移至顶部与服务选择并排：
         Key 本来就是服务级别的配置，跟选哪家服务放一起也说得通，
         离打字区域远了，误触不到。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinner_options"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dialog_text_primary"
            android:textSize="14sp"
            android:dropDownVerticalOffset="4dp"
            android:dropDownWidth="match_parent"
            android:popupBackground="@android:color/white"
            android:popupElevation="4dp" />

        <!-- 描边和文字取同一个色：OutlinedButton 的描边默认跟着 colorAccent（粉 #D81B60），
             文字却默认跟 colorPrimary（青绿 #008577），一小块按钮上两个色相撞在一起。
             统一用 colorPrimary，跟页面里的小节标题、气泡描边一个色系。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_mask"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/chat_api_key_show"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            app:cornerRadius="18dp"
            app:rippleColor="#26008577"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- API Key 输入框：默认收起，点上面那个按钮展开/收起
         （ChatBoxDialog.applyKeyVisibility() 控制） -->
    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:background="@drawable/bg_edit"
        android:hint="@string/chat_api_key_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/hint_text"
        android:textSize="12sp" />

    <!-- Ollama 接入方式：自建服务（地址可填）或官方云。选到 Ollama 时才出现 -->
    <LinearLayout
        android:id="@+id/ollama_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_spinner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/rg_ollama_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_ollama_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorAccent"
                android:checked="true"
                android:text="@string/chat_ollama_local"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_ollama_cloud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:buttonTint="@color/colorAccent"
                android:text="@string/chat_ollama_cloud"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_ollama_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit"
            android:hint="@string/chat_ollama_host_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/hint_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 模型：Ollama / OpenRouter 会从服务端拉一份列表，选中哪个用哪个 -->
    <LinearLayout
        android:id="@+id/model_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_spinner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_model"
            android:textColor="@color/dialog_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:minHeight="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/chat_model_pick"
            android:textSize="12sp" />

        <!-- 只留图标。文字挪到 contentDescription：无障碍朗读和长按提示都还用得上，
             但行内不再占宽度 -->
        <ImageButton
            android:id="@+id/btn_model_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/chat_model_refresh"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            android:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <!-- 消息显示区域 (占据剩余空间) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp"
        android:scrollbars="vertical" />

    <!-- 附件预览条 -->
    <LinearLayout
        android:id="@+id/file_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_spinner"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_file_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_submit"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/dialog_text_primary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ImageView
            android:id="@+id/iv_clear_file"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_small"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- 底部输入卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:contentPadding="10dp"
        app:cardBackgroundColor="@color/chat_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/chat_card_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 消息输入框 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit"
                android:hint="@string/msg"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/hint_text"
                android:textSize="14sp"
                android:maxLines="3"
                android:inputType="textMultiLine"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="1sp" />

            <!-- 底部操作栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/check_dpsk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/colorAccent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/check_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/r1"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_attach"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:text="@string/pkg"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/colorAccent"
                    app:strokeWidth="1.5dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="68dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:text="@string/commit"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
