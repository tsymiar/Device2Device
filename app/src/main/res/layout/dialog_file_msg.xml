<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/file_msg_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_file_trans_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_close_small" />
    </LinearLayout>

    <!-- 监听地址：服务端起来后填监听 IP:Port 并置灰不可编辑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="@string/file_msg_ip_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_file_trans_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:text="@string/file_msg_default_ip"
                android:textColor="@color/dark_grey" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/file_msg_port_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_file_trans_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="@string/file_msg_default_port"
                android:textColor="@color/dark_grey" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- ============ 接收端 / Server ============ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/file_msg_receiver"
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_file_trans_server"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/file_msg_start_server" 
        android:background="@drawable/bg_btn_square"
        android:textColor="@color/dialog_text_primary"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- ============ 发送端 / Client ============ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/file_msg_sender"
        android:textColor="@color/colorAccent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_file_trans_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/file_msg_connect" 
        android:background="@drawable/bg_btn_square"
        android:textColor="@color/dialog_text_primary"/>

    <!-- 连接成功后才展开：文件选择 + 发送/断开，全部归到发送端一组 -->
    <LinearLayout
        android:id="@+id/client_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_file_trans_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#f5f5f5"
                android:ellipsize="middle"
                android:hint="@string/file_msg_no_file"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/dark_grey" />

            <Button
                android:id="@+id/btn_file_trans_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/file_msg_select" 
        android:background="@drawable/bg_btn_square"
        android:textColor="@color/dialog_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_file_trans_disconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/file_msg_disconnect" 
        android:background="@drawable/bg_btn_square"
        android:textColor="@color/dialog_text_primary"/>

            <Button
                android:id="@+id/btn_file_trans_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/file_msg_send" 
        android:background="@drawable/bg_btn_square"
        android:textColor="@color/dialog_text_primary"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- ============ 日志 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/file_msg_log"
            android:textColor="@color/dark_grey"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_file_trans_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/file_msg_clear"
            android:textColor="@color/status_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_file_trans_log"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="8dp"
        android:background="#f5f5f5"
        android:fillViewport="false"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_file_trans_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_grey"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/pb_file_trans"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:visibility="gone" />

</LinearLayout>
