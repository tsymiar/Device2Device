<?xml version="1.0" encoding="utf-8"?>
<!--
  File Message 对话框：左右滑两页（接收端 / 发送端），不再把两种角色堆在一屏。
  · 标题 / 页签 / 状态进度 / 日志是共用区，只写一份，放在 ViewPager 外；
  · 两页各自的专属控件在 page_file_msg_receive.xml / page_file_msg_send.xml，
    地址输入行两页都 <include> 同一个 layout_file_msg_endpoint.xml；
  · 每页自己是 NestedScrollView，外层不滚动，因此没有嵌套滚动抢触摸的问题；
  · 高度自适应：根布局 wrap_content + WrapContentViewPager 按页面内容测高，
    窗口用 WRAP_CONTENT，只有超过 88% 屏高时才兜底夹紧。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lan_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- ===== 标题栏（共用） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/file_msg_title"
            android:textColor="@color/ui_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_file_trans_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_close_small" />
    </LinearLayout>

    <!-- ===== 页签（点选或左右滑 ViewPager 都会切换） ===== -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_file_trans"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/ui_accent"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/ui_accent"
        app:tabTextColor="@color/ui_text_dim" />

    <!-- ===== 状态卡片（共用）：状态行 + 速度 + 进度 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_lan_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/v_file_trans_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_lan_dot" />

            <TextView
                android:id="@+id/tv_file_trans_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/file_msg_state_idle"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_file_trans_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pb_file_trans"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="@color/ui_accent"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== 两页内容：接收端 / 发送端，左右滑切换 ===== -->
    <com.tsymiar.device2device.view.WrapContentViewPager
        android:id="@+id/vp_file_trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never" />

    <!-- ===== 日志（共用） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/file_msg_log"
            android:textColor="@color/ui_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_file_trans_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:text="@string/action_clear"
            android:textColor="@color/sel_lan_link_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_file_trans_log"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@drawable/bg_lan_panel"
        android:fillViewport="false"
        android:padding="8dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_file_trans_log_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/file_msg_log_empty"
                android:textColor="@color/ui_text_hint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_file_trans_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ui_text_dim"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
