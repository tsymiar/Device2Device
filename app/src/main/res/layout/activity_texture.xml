<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_opengl"
    tools:context=".activity.TextureActivity">

    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 渲染控制：居中压在纹理之上。
         底板用半透明黑，渲染出亮图时控件仍可辨认 -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_texture_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 渲染类型选择（菜单项与实际渲染通道一一对应） -->
        <Spinner
            android:id="@+id/spinner"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:popupBackground="#EEFFFFFF" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:background="@color/colorPrimaryDark"
                android:text="@string/pick_file"
                android:textAllCaps="true"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@color/colorPrimaryDark"
                android:text="@string/reload"
                android:textAllCaps="true"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 渲染模式：只决定 spinner 里给出哪些项，以及 GPU 失败时是否回退 CPU -->
        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mode_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/mode_auto"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_gpu"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_cpu"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- 选中文件路径 -->
        <TextView
            android:id="@+id/file_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="#EEEEEE"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 日志区：贴底竖排，由远及近（最上面最旧、最下面最新），
         每条单行截断，长日志也不会把上面/下面的条目顶出框外 -->
    <LinearLayout
        android:id="@+id/log_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_texture_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/log2"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha=".6"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/log1"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha=".8"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/log0"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

</FrameLayout>
