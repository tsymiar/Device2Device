<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ui_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ssh_sessions"
            android:textColor="@color/ui_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_ssh_temp"
            style="@style/CtrlKey"
            android:text="@string/ssh_session_temp" />

        <Button
            android:id="@+id/btn_ssh_new"
            style="@style/CtrlKeyAccent"
            android:layout_marginStart="6dp"
            android:text="@string/ssh_session_new" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ssh_session_hint"
        android:textColor="@color/ui_text_dim"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/ssh_session_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
