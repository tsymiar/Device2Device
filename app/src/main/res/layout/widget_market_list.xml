<?xml version="1.0" encoding="utf-8"?>
<!-- 行情桌面小部件：一个部件里放多个标的
     头部「行情 · N + 刷新」→ 中间是 ListView（标的数量超出可视高度时可上下滚动，
     RemoteViews 里只有 AdapterView 系列能真正滚动，ScrollView 会被拒绝 inflate；
     数据源是 MarketWidgetService，行布局见 widget_market_item.xml）→ 底部更新时间沉底；
     列表用 0dp + weight 1 吃掉剩余空间，更新时间就贴在部件底部；
     所有文字色都取 color 资源，日间 / 夜间自动切换（Provider 里还会按涨跌再覆盖一次） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_market"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/market_widget_title"
            android:textColor="@color/market_widget_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 只放图标：见 widget_market_heat.xml 里的同款说明 -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:paddingStart="5dp"
            android:paddingEnd="1dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:contentDescription="@string/market_widget_refresh"
            android:src="@drawable/ic_refresh"
            android:tint="@color/market_widget_text_dim" />

        <!-- 取数时在图标原位换成转圈，与 ChatBox「思考中…」那个 ProgressBar 同一套路：
             由系统画的 indeterminate 动画，比逐帧 setRotation 稳，也不受图标留白偏移影响。
             尺寸跟着静态图标走（16dp），换位时大小别跳 -->
        <ProgressBar
            android:id="@+id/widget_refresh_spin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_spin"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 标的列表：可滚动。Provider 用 setRemoteAdapter 挂上 MarketWidgetService，
         取数完成后 notifyAppWidgetViewDataChanged 让列表重新取数据 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fadingEdge="none"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <!-- 列表为空时的占位（setEmptyView 挂在列表上） -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/market_widget_loading"
        android:textColor="@color/market_widget_text_hint"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 取数时间：沉到部件右下角，与热力图 / 曲线两个部件同一处（都只有时分，不带「更新」二字） -->
    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="@string/market_widget_loading"
        android:textColor="@color/market_widget_text_hint"
        android:textSize="9sp" />

</LinearLayout>
