<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ui_card_alt"
    android:orientation="vertical"
    app:cardCornerRadius="16dp"
    android:padding="20dp">

    <!-- Header: file path info, clickable to open saved data -->
    <TextView
        android:id="@+id/tv_sending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="all"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="@string/sdcard_device2device"
        android:textColor="@color/ui_text_hint"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/ui_divider" />

    <!-- Directional pad -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- Center switch icon -->
        <ImageView
            android:id="@+id/img_switch"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_switch"
            tools:ignore="ContentDescription" />

        <!-- Up arrow: fills area above center -->
        <ImageView
            android:id="@+id/up"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@id/img_switch"
            android:layout_centerHorizontal="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_forward"
            tools:ignore="ContentDescription" />

        <!-- Down arrow: fills area below center -->
        <ImageView
            android:id="@+id/down"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@id/img_switch"
            android:layout_centerHorizontal="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            tools:ignore="ContentDescription" />

        <!-- Left arrow: fills area left of center -->
        <ImageView
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/img_switch"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_left"
            tools:ignore="ContentDescription" />

        <!-- Right arrow: fills area right of center -->
        <ImageView
            android:id="@+id/right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/img_switch"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_right"
            tools:ignore="ContentDescription" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/ui_divider" />

    <!-- Send status text -->
    <TextView
        android:id="@+id/text_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/ui_accent"
        android:textStyle="bold" />

    <!-- Bottom input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="true"
            android:hint="@string/edit_text"
            android:inputType="textCapCharacters"
            android:maxLength="8"
            android:minHeight="48dp"
            android:textColor="@color/ui_text"
            android:textColorHint="@color/ui_text_hint"
            android:textIsSelectable="false"
            android:typeface="monospace"
            tools:ignore="RelativeOverlap" />

        <ImageView
            android:id="@+id/img_submit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_submit"
            tools:ignore="ContentDescription" />

        <Button
            android:id="@+id/btn0"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/is_0"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
