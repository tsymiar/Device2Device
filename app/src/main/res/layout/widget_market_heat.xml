<?xml version="1.0" encoding="utf-8"?>
<!-- 行情热力图小部件：头部「市值热力图 · 更新时间 + 刷新」→ 中间一整片马赛克
     （一棵排版树铺成的 treemap，每个格子一只股票，面积=市值、颜色=涨跌幅）→ 底部一行图例。

     与列表版 widget_market_list.xml 同一个套路，区别只在主体的马赛克区域：
     - 排版在 MarketTreemap 里算好一棵树，顶层是「一行行横排」的几行，每行由
       MarketHeatWidgetService 铺成嵌套的 LinearLayout + TextView
       （见 widget_market_heat_row / widget_market_heat_col / widget_market_heat_tile）；
     - 格子宽高用 setInt(id, "setWidth" / "setHeight", px) 逐个设，于是「面积 = 市值」
       落在真实的 View 上，每一格可各自点击进入行情页（位图无法实现逐格点击；
       列表条目里的点击走 setPendingIntentTemplate + setOnClickFillInIntent）；
     - 摆 50 格、比一屏摆得下的多：画布比可见区域高，高出来的那些行滚过去才看得见；
     - 主体 0dp + weight 1 吃掉剩余空间；没数据时空态占位顶上。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_market"
    android:clipChildren="true"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/market_heat_widget_title"
                android:textColor="@color/market_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/market_widget_loading"
                android:textColor="@color/market_widget_text_hint"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 只放图标：跟 ChatBox 的模型刷新按钮一个路子，行内不再被"刷新"两个字占掉一截宽度。
             文字挪到 contentDescription，无障碍朗读照旧 -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:paddingStart="5dp"
            android:paddingEnd="1dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:contentDescription="@string/market_widget_refresh"
            android:src="@drawable/ic_refresh"
            android:tint="@color/market_widget_text_dim" />

        <!-- 取数时在图标原位换成转圈，与 ChatBox「思考中…」那个 ProgressBar 同一套路：
             由系统画的 indeterminate 动画，比逐帧 setRotation 稳，也不受图标留白偏移影响。
             尺寸跟着静态图标走（16dp），换位时大小别跳 -->
        <ProgressBar
            android:id="@+id/widget_refresh_spin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_spin"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 热力图主体：一摞「行」，由 MarketHeatWidgetService 逐行喂。外面套 FrameLayout 是
         为了叠「透明点击槽」—— 集合小部件里只有根布局那一层的点击真的生效。 -->
    <FrameLayout
        android:id="@+id/widget_market_heat_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <FrameLayout
            android:id="@+id/widget_market_heat_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true" />

