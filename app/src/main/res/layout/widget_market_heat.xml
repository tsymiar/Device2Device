    <!-- 底部一行：左边图例（面积与颜色各自代表什么，实际画了几只），右边取数时间。
         时间放这里而不是标题下：标题下面一行留给全市场涨跌家数，时间与图例同属「当前这屏是哪批数据」 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_legend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/market_heat_widget_legend"
