<?xml version="1.0" encoding="utf-8"?>
<!-- 外层 FrameLayout 只为挂一个整屏容器：指南针 / 水平仪卡片被点时把仪表搬进去最大化 -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="10dp"
		android:background="#EEEEEE"
		tools:context=".activity.GraphActivity">

	<!-- 指南针 + 水平仪 并排 -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginBottom="8dp">

		<!-- 指南针（方向）：点整张卡片最大化 -->
		<LinearLayout
			android:id="@+id/compass_card"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginEnd="4dp"
			android:orientation="vertical"
			android:padding="10dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="18dp"
					android:layout_marginEnd="8dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/ncompass"
					android:textColor="@color/colorPrimary"
					android:textSize="13sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="°"
					android:textColor="#999999"
					android:textSize="11sp" />
			</LinearLayout>

			<com.tsymiar.device2device.view.CompassView
				android:id="@+id/compass_view"
				android:layout_width="match_parent"
				android:layout_height="150dp" />
		</LinearLayout>

		<!-- 水平仪：点整张卡片最大化 -->
		<LinearLayout
			android:id="@+id/level_card"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="4dp"
			android:orientation="vertical"
			android:padding="10dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="18dp"
					android:layout_marginEnd="8dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/nlevel"
					android:textColor="@color/colorPrimary"
					android:textSize="13sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="°"
					android:textColor="#999999"
					android:textSize="11sp" />
			</LinearLayout>

			<com.tsymiar.device2device.view.BubbleLevelView
				android:id="@+id/level_view"
				android:layout_width="match_parent"
				android:layout_height="150dp" />
		</LinearLayout>
	</LinearLayout>

	<!-- 磁场强度 / 海拔 / 步数 / 距离：四个并排一行，不额外占用竖向空间 -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="10dp"
		android:orientation="horizontal">

		<!-- 磁场强度 -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginEnd="3dp"
			android:orientation="vertical"
			android:padding="6dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="16dp"
					android:layout_marginEnd="6dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:maxLines="1"
					android:text="@string/nmagnetic"
					android:textColor="@color/colorPrimary"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>

			<com.tsymiar.device2device.view.MagneticView
				android:id="@+id/magnetic_view"
				android:layout_width="match_parent"
				android:layout_height="90dp" />
		</LinearLayout>

		<!-- 海拔 -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="3dp"
			android:layout_marginEnd="3dp"
			android:orientation="vertical"
			android:padding="6dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="16dp"
					android:layout_marginEnd="6dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:maxLines="1"
					android:text="@string/naltitude"
					android:textColor="@color/colorPrimary"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>

			<com.tsymiar.device2device.view.AltitudeView
				android:id="@+id/altitude_view"
				android:layout_width="match_parent"
				android:layout_height="90dp" />
		</LinearLayout>

		<!-- 步数 -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="3dp"
			android:layout_marginEnd="3dp"
			android:orientation="vertical"
			android:padding="6dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="16dp"
					android:layout_marginEnd="6dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:maxLines="1"
					android:text="@string/nsteps"
					android:textColor="@color/colorPrimary"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>

			<com.tsymiar.device2device.view.StepView
				android:id="@+id/step_view"
				android:layout_width="match_parent"
				android:layout_height="90dp" />
		</LinearLayout>

		<!-- 距离 -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="3dp"
			android:orientation="vertical"
			android:padding="6dp"
			android:background="#F5F5F5"
			android:elevation="2dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="4dp">

				<View
					android:layout_width="3dp"
					android:layout_height="16dp"
					android:layout_marginEnd="6dp"
					android:background="@color/colorPrimary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:maxLines="1"
					android:text="@string/ndistance"
					android:textColor="@color/colorPrimary"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>

			<com.tsymiar.device2device.view.ProximityView
				android:id="@+id/proximity_view"
				android:layout_width="match_parent"
				android:layout_height="90dp" />
		</LinearLayout>
	</LinearLayout>

	<!-- 操作按钮 -->
	<Button
		android:id="@+id/bt"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginBottom="10dp"
		android:text="@string/start_chart"
		android:textSize="14sp"
		android:textColor="@android:color/white"
		android:backgroundTint="@color/colorPrimary"
		android:elevation="4dp"
		android:stateListAnimator="@null" />

	<!-- 图表容器 -->
	<androidx.fragment.app.FragmentContainerView
		android:id="@+id/fragment_container"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="@android:color/white"
		android:name="com.tsymiar.device2device.acceleration.DefaultFragment" />

	</LinearLayout>

	<!-- 最大化容器：仪表搬进来整屏显示，点任意位置（或返回键）还原 -->
	<FrameLayout
		android:id="@+id/zoom_host"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#EEEEEE"
		android:clickable="true"
		android:focusable="true"
		android:visibility="gone" />

</FrameLayout>
