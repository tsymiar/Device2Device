<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        tools:context=".activity.MainActivity"
        tools:ignore="MissingClass">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 顶部快捷入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_texture"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/texture"
                    app:chipIconVisible="false"
                    app:rippleColor="@color/colorPrimary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_wave"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/wave"
                    app:chipIconVisible="false"
                    app:rippleColor="@color/colorPrimary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_chart"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chart"
                    app:chipIconVisible="false"
                    app:rippleColor="@color/colorPrimary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_bluetooth"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/bluetooth"
                    app:chipIconVisible="false"
                    app:rippleColor="@color/colorAccent" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="#E0E0E0" />

            <!-- ================ 网络服务区域（可折叠） ================ -->
            <LinearLayout
                android:id="@+id/network_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_network"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/network_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 默认折叠，点标题栏展开 -->
            <LinearLayout
                android:id="@+id/network_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- Event + Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_event"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/event"
                        android:textSize="12sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_time"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/time"
                        android:textSize="12sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Event / Time 状态文字行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_event"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/dftHint"
                        android:textColor="#9E9E9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txt_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/dftHint"
                        android:textColor="#9E9E9E"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- UDP：server 绿框 / client 橙框 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/group_udp"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_udp_server"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/udp_listen"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:strokeColor="#4CAF50"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_udp_client"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/udp_send"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:strokeColor="#FF9800"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txt_udp_server"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/dftHint"
                                android:textColor="#9E9E9E"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txt_udp_client"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/dftHint"
                                android:textColor="#9E9E9E"
                                android:textSize="10sp" />
                        </LinearLayout>
                </LinearLayout>

                <!-- KCP：server 绿框 / client 橙框 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/group_kcp"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_kcp_server"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/kcp_server"
                                android:textColor="#4CAF50"
                                android:textSize="13sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#4CAF50"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_kcp_client"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:text="@string/kcp_client"
                                android:textSize="13sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#FF9800"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                        <!-- KCP 状态行：start 显示，stop 收回 -->
                        <LinearLayout
                            android:id="@+id/kcp_text_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txt_kcp_server"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/hint_text"
                                android:textSize="10sp"
                                android:textStyle="italic"
                                android:visibility="gone"
                                tools:ignore="RtlHardcoded" />

                            <TextView
                                android:id="@+id/txt_kcp_client"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/status_text"
                                android:textSize="10sp"
                                android:textStyle="italic"
                                android:visibility="gone"
                                tools:ignore="RtlHardcoded" />
                        </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#E0E0E0" />

            <!-- ================ 高级功能区域 ================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/section_advanced"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 订阅 & 发布 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_subscribe"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/subscribe"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_publisher"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/publish"
                    app:backgroundTint="@color/colorAccent"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#E0E0E0" />

            <!-- 文件与聊天区域 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/section_files"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/chat"
                    app:cornerRadius="20dp"
                    app:strokeColor="#4CAF50" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_file_trans"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/file_trans"
                    app:cornerRadius="20dp"
                    app:strokeColor="#2196F3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_http_server"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/http_server"
                    app:backgroundTint="#FF5722"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- HTTP 服务操作：复制访问地址 + 停止 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_http_copy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/http_server_copy"
                    app:cornerRadius="20dp"
                    app:strokeColor="#1976D2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_http_stop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/http_server_stop"
                    app:cornerRadius="20dp"
                    app:strokeColor="#FF5722" />
            </LinearLayout>

            <!-- SSH 服务：启动 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ssh_server"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="@string/ssh_server"
                app:backgroundTint="#00897B"
                app:cornerRadius="20dp" />

            <!-- SSH 服务操作：复制连接信息 + 停止（默认折叠，启动成功后展开） -->
            <LinearLayout
                android:id="@+id/ssh_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ssh_copy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/ssh_server_copy"
                    app:cornerRadius="20dp"
                    app:strokeColor="#00897B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ssh_stop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/ssh_server_stop"
                    app:cornerRadius="20dp"
                    app:strokeColor="#FF5722" />
            </LinearLayout>

            <!-- 行情 K线（归入 Services 组） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_market"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/market_quote"
                app:cornerRadius="20dp"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="1dp" />

            <!-- 人物 3D 模型（归入 Services 组） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_avatar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/avatar_3d"
                app:cornerRadius="20dp"
                app:strokeColor="#7E57C2"
                app:strokeWidth="1dp" />

            <!-- 游戏区域 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/section_game"
                android:textColor="@color/colorAccent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_deduction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/deduction_board"
                app:cornerRadius="20dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#E0E0E0" />

            <!-- 状态信息卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:contentPadding="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:paddingBottom="8dp"
                        android:text="@string/dftHint"
                        android:textColor="@color/hint_text"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        tools:ignore="RtlHardcoded" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/card_divider" />

                    <TextView
                        android:id="@+id/txt_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/dftHint"
                        android:textColor="@color/status_text"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        tools:ignore="RtlHardcoded" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- 底部 JNI 信息（页脚，固定底部） -->
    <TextView
        android:id="@+id/sample_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/hello_world"
        android:textColor="#BDBDBD"
        android:textSize="12sp" />

</LinearLayout>
