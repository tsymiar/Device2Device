<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天气泡底：一个 selector 装下"我发的"和"对端来的"两种。
     LanMsgDialog.appendChat() 给气泡 setActivated(kind == KIND_SELF)：
       activated = 我发的 —— 淡蓝，右下角收成小圆当"尾巴"
       默认      = 对端来的 —— 淡青，左下角收成小圆
     报错气泡另有一个（底色和描边都是红的，塞不进这个 selector）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lan_bubble_self" />
            <stroke
                android:width="1dp"
                android:color="@color/lan_bubble_stroke" />
            <corners
                android:bottomRightRadius="3dp"
                android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lan_bubble_peer" />
            <stroke
                android:width="1dp"
                android:color="@color/lan_bubble_stroke" />
            <corners
                android:bottomLeftRadius="3dp"
                android:radius="12dp" />
        </shape>
    </item>
</selector>
