<?xml version="1.0" encoding="utf-8"?>
<!-- 设备列表 / 消息区这类内嵌面板：浅底 + 细描边，和外面的白卡片分层 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lan_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/lan_stroke" />
    <corners android:radius="8dp" />
    <padding
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
</shape>
