<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件底板：圆角卡片，底色与描边都取 color 资源，日间为白卡、夜间为深色卡 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/market_widget_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/market_widget_stroke" />
    <corners android:radius="14dp" />
</shape>
